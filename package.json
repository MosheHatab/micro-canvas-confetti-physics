{
  "name": "micro-canvas-confetti-physics",
  "version": "0.1.0",
  "description": "Zero-dependency canvas confetti — presets, sequences, reach limits, and custom 2D motion (gravity, drag, 3D wobble) at 60fps.",
  "type": "module",
  "license": "MIT",
  "author": "Moshe Hatab",
  "keywords": [
    "confetti",
    "canvas",
    "physics",
    "animation",
    "typescript",
    "particles",
    "celebration",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosheHatab/micro-canvas-confetti-physics.git"
  },
  "homepage": "https://moshehatab.github.io/micro-canvas-confetti-physics/",
  "bugs": {
    "url": "https://github.com/MosheHatab/micro-canvas-confetti-physics/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./physics": {
      "import": {
        "types": "./dist/physics.d.ts",
        "default": "./dist/physics.js"
      },
      "require": {
        "types": "./dist/physics.d.cts",
        "default": "./dist/physics.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "vite --config vite.demo.config.ts",
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/postbuild.mjs",
    "build:iife": "vite build --config vite.iife.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc --out docs/api src/index.ts",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "size": "size-limit",
    "check:package": "publint && attw --pack . --profile node16",
    "publish:safe": "npm run build && npm run check:package && npm publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.58.9",
    "@playwright/test": "^1.52.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "happy-dom": "^17.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.4",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.2",
    "typedoc": "^0.28.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
